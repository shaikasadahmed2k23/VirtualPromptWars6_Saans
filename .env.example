# Copy to .env and fill in. Never commit .env.

# HTTP port the server listens on (Render injects this automatically).
PORT=8080

# development | production | test
NODE_ENV=development

# pino log level: fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# Directory holding the built web app, relative to the working directory.
WEB_DIST_DIR=web/dist

# Google AI Studio key. Server-side only, never exposed to the browser.
GEMINI_API_KEY=

# Gemini model id, configured here and never hardcoded in source.
GEMINI_MODEL=
