# Copy to .env and fill in. Never commit .env.

# HTTP port the server listens on (Render injects this automatically).
PORT=8080

# Interface to bind. 0.0.0.0 is required inside containers.
HOST=0.0.0.0

# development | production | test
NODE_ENV=production

# pino log level: fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# Directory holding the built web app, relative to the working directory.
WEB_DIST_DIR=web/dist

# Google AI Studio key. Server-side only, never exposed to the browser.
GEMINI_API_KEY=

# Gemini model id, configured here and never hardcoded in source.
GEMINI_MODEL=gemini-3.1-flash-lite

# Optional ordered list, tried once each within a 20 s budget before the offline plan takes over.
# When set it wins over GEMINI_MODEL.
GEMINI_MODELS=

# Optional: low | medium | high. Thinking models (e.g. gemini-3.5-flash and up) can spend 20 s+ reasoning
# and miss the 8 s budget; "low" cuts that. Leave blank for models without thinking (e.g. flash-lite).
GEMINI_THINKING_LEVEL=
